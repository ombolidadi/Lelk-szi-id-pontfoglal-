# Nyilvános cím, ahol az alkalmazás elérhető (Google átirányításhoz és e-mail linkekhez)
BASE_URL=http://localhost:3000
PORT=3000
# Hosszú, véletlen titok (pl.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Adatbázis fájl helye (alapértelmezés: ./data/app.db)
# DATABASE_FILE=/data/app.db

# Google Cloud OAuth kliens (Web application típus)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcionális SMTP e-mail értesítésekhez
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Gyülekezet <idopont@example.com>"
