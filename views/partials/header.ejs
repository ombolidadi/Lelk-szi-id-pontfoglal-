<!doctype html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> – <%= settings.org_name %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">✝</span> <%= settings.org_name %></a>
    <nav>
      <% if (currentUser) { %>
        <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Lelkészi felület</a>
        <form method="post" action="/admin/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="link">Kijelentkezés</button>
        </form>
      <% } else { %>
        <a href="/admin/login">Lelkészi belépés</a>
      <% } %>
    </nav>
  </div>
</header>
<% if (currentUser && path.startsWith('/admin') && !['/admin/login','/admin/setup'].includes(path)) { %>
<nav class="subnav">
  <div class="wrap">
    <a href="/admin" class="<%= path === '/admin' || path === '/admin/' ? 'active' : '' %>">Foglalások</a>
    <a href="/admin/availability" class="<%= path.startsWith('/admin/availability') ? 'active' : '' %>">Elérhetőség</a>
    <a href="/admin/google" class="<%= path.startsWith('/admin/google') ? 'active' : '' %>">Google naptár</a>
    <a href="/admin/services" class="<%= path.startsWith('/admin/services') ? 'active' : '' %>">Szolgáltatások</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/admin/pastors" class="<%= path.startsWith('/admin/pastors') ? 'active' : '' %>">Lelkészek</a>
      <a href="/admin/settings" class="<%= path.startsWith('/admin/settings') ? 'active' : '' %>">Beállítások</a>
    <% } %>
    <a href="/admin/profile" class="<%= path.startsWith('/admin/profile') ? 'active' : '' %>">Profil</a>
  </div>
</nav>
<% } %>
<main class="wrap">
<% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.text %></div><% } %>
