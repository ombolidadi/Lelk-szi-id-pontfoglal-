<!doctype html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> – <%= settings.org_name %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% const inAdmin = path.startsWith('/admin'); %>
<header class="topbar">
  <div class="wrap topbar-inner">
    <% if (group) { %>
      <a class="brand" href="/csoport/<%= group.slug %>"><span class="brand-mark" aria-hidden="true">✝</span> <%= group.name %></a>
    <% } else { %>
      <span class="brand"><span class="brand-mark" aria-hidden="true">✝</span> <%= settings.org_name %></span>
    <% } %>
    <nav>
      <% if (inAdmin) { %>
        <% if (currentUser) { %>
          <span class="muted small"><%= currentUser.name %></span>
          <form method="post" action="/admin/logout" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-small">Kijelentkezés</button>
          </form>
        <% } %>
      <% } else if (currentClient) { %>
        <a href="/fiok" class="<%= path === '/fiok' ? 'active' : '' %>">Foglalásaim</a>
        <form method="post" action="/fiok/kilepes" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-small">Kijelentkezés</button>
        </form>
      <% } else if (group || path.startsWith('/fiok') || path.startsWith('/foglalas')) { %>
        <a href="/fiok/belepes<%= group ? '?vissza=' + encodeURIComponent(path) : '' %>">Belépés</a>
      <% } %>
    </nav>
  </div>
</header>
<% if (currentUser && inAdmin && !['/admin/login','/admin/setup','/admin/login/2fa'].includes(path) && !path.startsWith('/admin/meghivo')) { %>
<nav class="subnav">
  <div class="wrap">
    <a href="/admin" class="<%= path === '/admin' || path === '/admin/' ? 'active' : '' %>">Foglalások</a>
    <a href="/admin/availability" class="<%= path.startsWith('/admin/availability') ? 'active' : '' %>">Elérhetőség</a>
    <a href="/admin/google" class="<%= path.startsWith('/admin/google') ? 'active' : '' %>">Google naptár</a>
    <a href="/admin/services" class="<%= path.startsWith('/admin/services') ? 'active' : '' %>">Szolgáltatások</a>
    <a href="/admin/groups" class="<%= path.startsWith('/admin/groups') ? 'active' : '' %>">Csoportok</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/admin/pastors" class="<%= path.startsWith('/admin/pastors') ? 'active' : '' %>">Lelkészek</a>
      <a href="/admin/settings" class="<%= path.startsWith('/admin/settings') ? 'active' : '' %>">Beállítások</a>
    <% } %>
    <a href="/admin/profile" class="<%= path.startsWith('/admin/profile') || path.startsWith('/admin/2fa') ? 'active' : '' %>">Profil</a>
    <form method="post" action="/admin/logout" class="inline subnav-logout">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="link">Kijelentkezés</button>
    </form>
  </div>
</nav>
<% } %>
<main class="wrap">
<% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.text %></div><% } %>
