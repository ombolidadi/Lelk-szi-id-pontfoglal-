<%- include('partials/header') %>
<section class="hero">
  <h1>Időpontfoglalás</h1>
  <p><%= settings.org_intro %></p>
</section>

<h2>Válasszon szolgáltatást</h2>
<% if (!services.length) { %>
  <p class="muted">Jelenleg nincs foglalható szolgáltatás.</p>
<% } %>
<div class="grid">
  <% services.forEach(function (s) { %>
    <a class="card service-card" href="/szolgaltatas/<%= s.slug %>" style="--accent: <%= s.color %>">
      <h3><%= s.name %></h3>
      <% if (s.description) { %><p><%= s.description %></p><% } %>
      <p class="meta"><%= s.duration_min %> perc<% if (s.location) { %> · <%= s.location %><% } %></p>
      <span class="btn btn-small">Időpontot foglalok</span>
    </a>
  <% }) %>
</div>

<% if (pastors.length) { %>
<h2>Lelkészeink</h2>
<div class="grid">
  <% pastors.forEach(function (p) { %>
    <div class="card">
      <h3><%= p.name %></h3>
      <% if (p.title) { %><p class="meta"><%= p.title %></p><% } %>
      <% if (p.bio) { %><p><%= p.bio %></p><% } %>
      <div class="chips">
        <% services.filter(function (s) { return pastorServices.some(function (ps) { return ps.user_id === p.id && ps.service_id === s.id; }); }).forEach(function (s) { %>
          <a class="chip" href="/szolgaltatas/<%= s.slug %>?lelkesz=<%= p.id %>"><%= s.name %></a>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>
<% } %>
<%- include('partials/footer') %>
