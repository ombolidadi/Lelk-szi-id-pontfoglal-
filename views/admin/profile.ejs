<%- include('../partials/header') %>
<h1>Profil</h1>
<section class="card narrow">
  <h3>Kétfaktoros hitelesítés</h3>
  <% if (user.totp_enabled) { %>
    <p>Bekapcsolva ✓ – belépéskor a jelszó mellett a hitelesítő alkalmazás kódját is kérjük.</p>
  <% } else { %>
    <p class="muted">Nincs bekapcsolva. Ajánlott: a jelszó mellé a telefonja is kell a belépéshez.</p>
  <% } %>
  <a class="btn" href="/admin/2fa"><%= user.totp_enabled ? 'Kezelés' : 'Bekapcsolás' %></a>
</section>
<form method="post" class="card narrow">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Név<input name="name" required value="<%= user.name %>"></label>
  <label>Megnevezés (pl. „parókus lelkész”)<input name="title" value="<%= user.title %>"></label>
  <label>Gyülekezet<input name="congregation" maxlength="120" value="<%= user.congregation || '' %>" placeholder="pl. Budavári Református Gyülekezet"></label>
  <label>Rövid bemutatkozás<textarea name="bio" rows="4"><%= user.bio %></textarea></label>
  <label>E-mail cím (belépéshez és értesítésekhez)<input name="email" type="email" required value="<%= user.email %>"></label>
  <h3>Jelszócsere</h3>
  <label>Jelenlegi jelszó<input name="current_password" type="password" autocomplete="current-password"></label>
  <label>Új jelszó (hagyja üresen, ha nem változtat)<input name="new_password" type="password" minlength="8" autocomplete="new-password"></label>
  <button class="btn btn-primary">Mentés</button>
</form>
<%- include('../partials/footer') %>
