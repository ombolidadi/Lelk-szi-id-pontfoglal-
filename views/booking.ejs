<%- include('partials/header') %>
<section class="card narrow">
  <% if (booking.status === 'cancelled') { %>
    <h1>Lemondott foglalás</h1>
    <p>Ez a foglalás le lett mondva.</p>
  <% } else { %>
    <h1>Foglalás visszaigazolása</h1>
    <p>Köszönjük! Időpontját rögzítettük. Kérjük, mentse el ezt az oldalt (vagy a linkjét), ha később le szeretné mondani.</p>
  <% } %>
  <dl class="details">
    <dt>Szolgáltatás</dt><dd><%= booking.service_name %></dd>
    <dt>Lelkész</dt><dd><%= booking.pastor_name %><% if (booking.pastor_congregation) { %> <small class="muted">(<%= booking.pastor_congregation %>)</small><% } %></dd>
    <dt>Időpont</dt><dd><%= when %></dd>
    <% if (booking.location) { %><dt>Helyszín</dt><dd><%= booking.location %></dd><% } %>
    <dt>Név</dt><dd><%= booking.client_name %></dd>
    <dt>E-mail</dt><dd><%= booking.client_email %></dd>
  </dl>
  <% if (booking.status === 'confirmed' && !isPast) { %>
    <p class="actions">
      <a class="btn" href="<%= gcalLink %>" target="_blank" rel="noopener">Hozzáadás a Google Naptárhoz</a>
      <% if (currentClient && booking.client_id === currentClient.id) { %><a class="btn btn-ghost" href="/fiok">Foglalásaim</a><% } %>
    </p>
    <form method="post" action="/foglalas/<%= booking.token %>/lemondas" onsubmit="return confirm('Biztosan lemondja az időpontot?')">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn btn-danger">Időpont lemondása</button>
    </form>
  <% } %>
  <% if (booking.group_slug) { %><p><a href="/csoport/<%= booking.group_slug %>">← <%= booking.group_name %></a></p><% } %>
</section>
<%- include('partials/footer') %>
